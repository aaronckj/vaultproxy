/target/
/config/
*.sqlite
*.key
*.pem
# iter-12: Encrypted keystore files (credentials.enc, private_key.enc,
# private_key.tpm_enc) must never be committed.  /config/ already excludes
# the default config directory, but *.enc / *.tpm_enc catches any file
# placed outside config/ (e.g. a custom --config-dir path used for tests).
*.enc
*.tpm_enc
# Environment / secret files. `.env` alone did NOT match `wg.env` (the
# WireGuard private-key env used by deploy/), so a `git add -A` could leak it.
# `*.env` catches all of them; `*.env.example` files end in `.example` and are
# not matched, so checked-in examples stay tracked.
.env
*.env
